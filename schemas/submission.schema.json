{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoadModel independent evaluation submission",
  "type": "object",
  "required": ["schema", "jobs"],
  "properties": {
    "schema": {"const": "roadmodel.submission/v1"},
    "action": {"enum": ["report_existing", "prepare_execution"]},
    "jobs": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
        "kind": {"enum": ["model_accuracy", "compile_alignment"]},
        "profile": {"type": "string"},
        "model_ref": {"type": "string"},
        "dataset_ref": {"type": "string"},
        "request_file": {"type": "string"},
        "report": {"type": "object"},
        "scope": {"type": "object"},
        "layout": {"enum": ["business", "diagnostic"]}
      }
    }}
  }
}
