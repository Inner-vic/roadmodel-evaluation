  "title": "RoadModel 两输入评测工单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_delivery_url",
    "dataset_url"
  ],
  "properties": {
    "model_delivery_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "dataset_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    }
  }
}
